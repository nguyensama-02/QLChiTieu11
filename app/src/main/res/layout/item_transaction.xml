<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_phinova_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvBieuTuongGiaoDich"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_transaction_icon"
        android:gravity="center"
        android:text="₫"
        android:textColor="#0891B2"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDanhMucGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Mua sắm"
            android:textColor="#102A4C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGhiChuGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Không có ghi chú"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvNgayGiaoDichItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="25/10/2026"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSoTienGiaoDichItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="-1.000.000 ₫"
        android:textColor="#DC2626"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
