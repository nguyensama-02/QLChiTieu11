<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_gradient"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvQuayLaiLichSu"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Quay lại"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lịch sử giao dịch"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPhuDeLichSu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Theo dõi mọi khoản thu và chi của bạn"
            android:textColor="#C5D7EB"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/edtTimGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_input"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Tìm danh mục hoặc ghi chú..."
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#102A4C"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleLocGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:checkedButton="@id/btnTatCa"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTatCa"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textColor="@color/toggle_text_color"
                android:textSize="12sp"
                app:backgroundTint="@color/toggle_button_bg"
                app:cornerRadius="12dp"
                app:strokeColor="@color/toggle_stroke_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocThu"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Thu"
                android:textAllCaps="false"
                android:textColor="@color/toggle_text_color"
                android:textSize="12sp"
                app:backgroundTint="@color/toggle_button_bg"
                app:cornerRadius="12dp"
                app:strokeColor="@color/toggle_stroke_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocChi"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Chi"
                android:textAllCaps="false"
                android:textColor="@color/toggle_text_color"
                android:textSize="12sp"
                app:backgroundTint="@color/toggle_button_bg"
                app:cornerRadius="12dp"
                app:strokeColor="@color/toggle_stroke_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocChuyen"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Chuyển"
                android:textAllCaps="false"
                android:textColor="@color/toggle_text_color"
                android:textSize="12sp"
                app:backgroundTint="@color/toggle_button_bg"
                app:cornerRadius="12dp"
                app:strokeColor="@color/toggle_stroke_color" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvSoLuongGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="0 giao dịch"
            android:textColor="#64748B"
            android:textSize="13sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutLichSuTrong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_auth_card"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#94A3B8"
                android:textSize="42sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Không tìm thấy giao dịch"
                android:textColor="#102A4C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hãy thử thay đổi bộ lọc hoặc tìm kiếm"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLichSuGiaoDich"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>